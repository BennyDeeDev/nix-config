{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_MODEL}",
  "default_agent": "plan",
  "agent": {
    "generalist": {
      "model": "{env:OPENCODE_MODEL}"
    },
    "tutor": {
      "model": "{env:OPENCODE_MODEL}"
    },
    "reviewer": {
      "model": "{env:OPENCODE_MODEL}"
    },
    "compaction": {
      "model": "{env:OPENCODE_MODEL}"
    }
  },
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 200000
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "mv *": "ask",
      "sudo *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "git *": "ask",
      "git add": "allow",
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git annotate *": "allow",
      "git grep *": "allow",
      "git branch --list *": "allow",
      "git tag --list *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git ls-remote *": "allow",
      "git ls-tree *": "allow",
      "git cat-file *": "allow",
      "git merge-base *": "allow",
      "git for-each-ref *": "allow",
      "git show-ref *": "allow",
      "git describe *": "allow",
      "git help *": "allow",
      "git version *": "allow",
      "git config --list *": "allow",
      "git config --get *": "allow",
      "git remote -v *": "allow",
      "git remote show *": "allow",
      "git remote get-url *": "allow",
      "git stash list *": "allow",
      "git stash show *": "allow",
      "git submodule status *": "allow",
      "git worktree list *": "allow",
      "git reflog show *": "allow",
      "git fsck *": "allow",
      "git check-ignore *": "allow",
      "gh *": "ask",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr status *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh repo view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "kubectl *": "ask",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl events *": "allow",
      "kubectl explain *": "allow",
      "kubectl top *": "allow",
      "kubectl cluster-info *": "allow",
      "kubectl api-resources *": "allow",
      "kubectl api-versions *": "allow",
      "kubectl version *": "allow",
      "kubectl diff *": "allow",
      "kubectl auth can-i *": "allow",
      "kubectl auth whoami *": "allow",
      "kubectl rollout history *": "allow",
      "kubectl rollout status *": "allow",
      "kubectl config current-context *": "allow",
      "kubectl config get-contexts *": "allow",
      "kubectl config view *": "allow",
      "kubectl wait *": "allow",
      "kubectl exec *": "deny",
      "kubectl run *": "deny",
      "podman *": "ask",
      "podman ps *": "allow",
      "podman images *": "allow",
      "podman logs *": "allow",
      "podman inspect *": "allow",
      "podman stats *": "allow",
      "podman version *": "allow",
      "podman info *": "allow",
      "podman history *": "allow",
      "podman diff *": "allow",
      "podman top *": "allow",
      "podman events *": "allow",
      "podman port *": "allow",
      "podman wait *": "allow",
      "podman network ls *": "allow",
      "podman network inspect *": "allow",
      "podman volume ls *": "allow",
      "podman volume inspect *": "allow",
      "podman system df *": "allow",
      "podman compose ps *": "allow",
      "podman compose config *": "allow",
      "podman compose images *": "allow",
      "podman compose logs *": "allow",
      "podman compose top *": "allow",
      "podman compose port *": "allow",
      "podman compose stats *": "allow",
      "podman compose version *": "allow",
      "podman compose ls *": "allow",
      "flux *": "ask",
      "flux check *": "allow",
      "flux debug *": "allow",
      "flux diff *": "allow",
      "flux events *": "allow",
      "flux export *": "allow",
      "flux get *": "allow",
      "flux list *": "allow",
      "flux logs *": "allow",
      "flux stats *": "allow",
      "flux trace *": "allow",
      "flux tree *": "allow",
      "flux version *": "allow",
      "helm *": "ask",
      "helm dependency list *": "allow",
      "helm env *": "allow",
      "helm get *": "allow",
      "helm help *": "allow",
      "helm history *": "allow",
      "helm lint *": "allow",
      "helm list *": "allow",
      "helm repo list *": "allow",
      "helm search *": "allow",
      "helm show *": "allow",
      "helm status *": "allow",
      "helm template *": "allow",
      "helm verify *": "allow",
      "helm version *": "allow"
    }
  }
}
