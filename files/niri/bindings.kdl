binds {
    // `include` DMS binds above your own to let your binds override defaults.
    // include "~/.config/niri/dms/binds.kdl"

    // === Application Launchers ===
    Ctrl+Shift+T { spawn "ghostty"; }
    Ctrl+Shift+F { spawn "nautilus"; }
    Ctrl+Shift+B { spawn "brave"; }
    Ctrl+Shift+E { spawn "code"; }
    Ctrl+Shift+P { spawn "keepassxc"; }
    Ctrl+Shift+S { spawn "spotify"; }

    // === DMS IPC ===
    Ctrl+Space   { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Ctrl+Shift+L { spawn "dms" "ipc" "call" "lock" "lock"; }
    Ctrl+Shift+W { spawn "dms" "restart"; }
    Super+Comma  { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Super+N      { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Super+M      { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Super+V      { spawn "dms" "ipc" "call" "clipboard" "toggle"; }

    // === Window Management ===
    Ctrl+Q       { close-window; }
    Ctrl+Shift+Q { quit; }
    Ctrl+Shift+V { toggle-window-floating; }

    // === Overview ===
    Super+Shift+O repeat=false { toggle-overview; }

    // === Sizing ===
    Super+Shift+R { switch-preset-column-width; }
    Super+Minus       { set-column-width "-10%"; }
    Super+Equal       { set-column-width "+10%"; }
    Super+Shift+Minus { set-window-height "-10%"; }
    Super+Shift+Equal { set-window-height "+10%"; }

    // === Focus Navigation ===
    Super+H { focus-column-left; }
    Super+L { focus-column-right; }
    Super+K { focus-window-up; }
    Super+J { focus-window-down; }

    // === Window Movement ===
    Super+Shift+H { move-column-left; }
    Super+Shift+L { move-column-right; }
    Super+Shift+K { move-window-up; }
    Super+Shift+J { move-window-down; }

    // === Tab Switching ===
    Ctrl+Tab       { focus-column-right-or-first; }
    Ctrl+Shift+Tab { focus-column-left-or-last; }

    // === Workspace Navigation (F-keys) ===
    F1  { focus-workspace 1; }
    F2  { focus-workspace 2; }
    F3  { focus-workspace 3; }
    F4  { focus-workspace 4; }
    F5  { focus-workspace 5; }
    F6  { focus-workspace 6; }
    F7  { focus-workspace 7; }
    F8  { focus-workspace 8; }
    F9  { focus-workspace 9; }
    F10 { focus-workspace 10; }

    // === Move to Workspace ===
    Shift+F1  { move-window-to-workspace 1; }
    Shift+F2  { move-window-to-workspace 2; }
    Shift+F3  { move-window-to-workspace 3; }
    Shift+F4  { move-window-to-workspace 4; }
    Shift+F5  { move-window-to-workspace 5; }
    Shift+F6  { move-window-to-workspace 6; }
    Shift+F7  { move-window-to-workspace 7; }
    Shift+F8  { move-window-to-workspace 8; }
    Shift+F9  { move-window-to-workspace 9; }
    Shift+F10 { move-window-to-workspace 10; }

    // === Screenshots ===
    Print        { spawn "dms" "ipc" "call" "niri" "screenshot"; }
    Ctrl+Shift+4 { spawn "dms" "ipc" "call" "niri" "screenshot"; }

    // === Audio Controls ===
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute        allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }

    Alt+XF86AudioRaiseVolume { spawn "dms" "ipc" "call" "audio" "increment" "1"; }
    Alt+XF86AudioLowerVolume { spawn "dms" "ipc" "call" "audio" "decrement" "1"; }

    // === Brightness Controls ===
    // XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5"; }
    // XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5"; }
    // Alt+XF86MonBrightnessUp   { spawn "dms" "ipc" "call" "brightness" "increment" "1"; }
    // Alt+XF86MonBrightnessDown { spawn "dms" "ipc" "call" "brightness" "decrement" "1"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "asdbctl" "up" "-s" "5"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "asdbctl" "down" "-s" "5"; }
    Alt+XF86MonBrightnessUp   { spawn "asdbctl" "up" "-s" "1"; }
    Alt+XF86MonBrightnessDown { spawn "asdbctl" "down" "-s" "1"; }

    // === Media Controls ===
    XF86AudioPause allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay  allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
}
